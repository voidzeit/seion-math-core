{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seion.invalid/schema/governance-action.json",
  "title": "SEION governed action request",
  "type": "object",
  "required": ["action", "risk", "evidence_authority", "human_approval"],
  "properties": {
    "action": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "evidence_authority": {"type": "string", "enum": ["declared", "observed", "verified", "approved"]},
    "human_approval": {"type": "boolean"},
    "claim_ids": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"}
  },
  "additionalProperties": false
}
